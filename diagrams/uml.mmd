classDiagram
    class Task {
        +str description
        +str time
        +str frequency
        +date due_date
        +bool completed
        +str pet_name
        +mark_complete() None
        +next_occurrence() Task
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
    }

    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pet(name: str) Pet
        +get_all_tasks() List~Task~
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() List~Task~
        +sort_by_time(tasks: List~Task~) List~Task~
        +filter_tasks(pet_name: str, completed: bool) List~Task~
        +get_todays_schedule() List~Task~
        +mark_task_complete(task: Task) Task
        +detect_conflicts() List~str~
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" o-- "*" Task : has
    Scheduler --> Owner : manages
    Task ..> Task : next_occurrence creates
